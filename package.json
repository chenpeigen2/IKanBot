{
  "name": "ikanbot",
  "version": "0.4.0",
  "description": "外贸商品录入与 PI/PL 单据生成系统",
  "main": "./out/main/index.js",
  "author": "IKanBot",
  "homepage": "https://github.com/chenpeigen2/IKanBot",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:e2e": "node scripts/build-test.cjs && node out/test/e2e-test.cjs",
    "test:mode": "node scripts/build-mode-test.cjs && npm run build --prefix server && node out/test/mode-test.cjs",
    "test:all": "npm run test:e2e && npm run test:mode && npm test --prefix server",
    "build:test": "node scripts/build-test.cjs",
    "test:pdf": "node scripts/build-pdftest.cjs && electron out/test/pdftest.cjs",
    "seed": "node scripts/build-seed.cjs && node out/test/seed.cjs",
    "agent:iterate": "echo run via pi subagent"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-sqlite3-wasm": "^0.8.61"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
